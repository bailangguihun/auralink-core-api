# Auralink Core API
# This file is only a template. Do not commit the real .env file.

SERVER_PORT=5000

# SQLite database
DATABASE_URL=jdbc:sqlite:./data/auralink.db

# Replace with a long random secret in the real environment.
JWT_SECRET=replace_with_a_long_random_secret

# AI services
VMM_URL=http://localhost:5001
VISION_URL=http://localhost:5002

# Persistent storage
UPLOAD_DIR=./data/uploads
AUDIO_DIR=./data/audio
PICTURE_DIR=./data/picture

# Public URL used when returning painting image addresses
IMAGE_BASE_URL=https://api.auralinks.top/api/paintings/images

# Painting catalogue metadata
PAINTINGS_CSV_PATH=./data/paintings.csv
