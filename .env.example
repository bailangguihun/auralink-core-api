# Authentication
AURALINK_JWT_SECRET=
AURALINK_JWT_EXPIRATION_MS=604800000

# Spring launch and operational configuration
# Export AURALINK_ENV_FILE before launch when the process working directory is not backend/.
AURALINK_ENV_FILE=./.env
SERVER_PORT=5000
AURALINK_DATABASE_URL=jdbc:sqlite:./auralink.db
AURALINK_JPA_DDL_AUTO=none
AURALINK_FLYWAY_ENABLED=false

AURALINK_VMM_URL=http://localhost:5001
AURALINK_QWEN_SERVICE_URL=http://localhost:5002

AURALINK_UPLOAD_DIR=./temp_uploads
AURALINK_AUDIO_DIR=../VMM-frontend/project/public/audios
AURALINK_LEGACY_FRONTEND_AUDIO_DIR=../frontend/public/audios

# Auralink 2.0 MediaAsset storage and non-secret safety limits
AURALINK_MEDIA_ASSET_DIR=./temp_uploads/media-assets
AURALINK_MEDIA_ASSET_MAX_UPLOAD_BYTES=10485760
AURALINK_MEDIA_ASSET_MAX_GENERATED_BYTES=268435456
AURALINK_MEDIA_ASSET_MAX_IMAGE_PIXELS=40000000
AURALINK_MEDIA_ASSET_PUBLIC_CACHE_SECONDS=86400

AURALINK_PAINTING_CSV_PATH=../frontend/public/data/paintings.csv
AURALINK_PAINTING_PICTURE_DIR=./picture
AURALINK_PAINTING_IMAGE_BASE_URL=https://api.auralinks.top/api/paintings/images
AURALINK_PAINTING_CATALOG_IMPORT_ENABLED=false
AURALINK_PAINTING_CATALOG_IMPORT_FAIL_ON_ERROR=true
AURALINK_PAINTING_CATALOG_IMPORT_BATCH_SIZE=100
AURALINK_PAINTING_DAILY_ZONE=Asia/Shanghai

# AI Painting Guide (disabled until the separate local adapter is reviewed and started)
AURALINK_GUIDE_ENABLED=false
GUIDE_AI_SERVICE_URL=http://127.0.0.1:5003
AURALINK_GUIDE_CONNECT_TIMEOUT_MS=5000
AURALINK_GUIDE_READ_TIMEOUT_MS=120000
AURALINK_GUIDE_TOTAL_TIMEOUT_MS=250000
AURALINK_GUIDE_INTERNAL_READ_TIMEOUT_MS=380000
AURALINK_GUIDE_RETRY_BACKOFF_MS=200
AURALINK_GUIDE_MAX_CONCURRENT_GENERATIONS=2
AURALINK_GUIDE_USER_GENERATION_LIMIT=3
AURALINK_GUIDE_USER_GENERATION_WINDOW_SECONDS=600
AURALINK_GUIDE_GLOBAL_GENERATION_LIMIT=30
AURALINK_GUIDE_GLOBAL_GENERATION_WINDOW_SECONDS=3600
AURALINK_GUIDE_SCHEMA_VERSION=1
AURALINK_GUIDE_MAX_KNOWLEDGE_ITEMS=5
AURALINK_GUIDE_MAX_KNOWLEDGE_CHARS=8000
AURALINK_GUIDE_POETRY_GRAPH_PATH=../frontend/public/data/poetry-graph.json
AURALINK_GUIDE_POETRY_STATS_PATH=../frontend/public/data/poetry-stats.json
AURALINK_GUIDE_INTERNAL_TOKEN=
AURALINK_GUIDE_SERVICE_HOST=127.0.0.1
AURALINK_GUIDE_SERVICE_PORT=5003

# Private reusable workflow definitions (definition only; execution remains unavailable)
AURALINK_WORKFLOWS_ENABLED=false
AURALINK_WORKFLOW_SCHEMA_VERSION=1
AURALINK_WORKFLOW_MAX_GRAPH_BYTES=65536
AURALINK_WORKFLOW_MAX_NODES=16
AURALINK_WORKFLOW_MAX_EDGES=15
AURALINK_WORKFLOW_MAX_NAME_CHARS=120
AURALINK_WORKFLOW_MAX_DESCRIPTION_CHARS=2000

# Creation execution persistence. Disabled by default; ROUND 9B.2 starts one bounded worker only when enabled.
AURALINK_CREATIONS_ENABLED=false
AURALINK_CREATIONS_WORKER_COUNT=1
AURALINK_CREATIONS_QUEUE_CAPACITY=16
AURALINK_CREATIONS_EXECUTOR_QUEUE_CAPACITY=1
AURALINK_CREATIONS_LEASE_DURATION_SECONDS=600
AURALINK_CREATIONS_DISPATCH_DELAY_MS=1000
AURALINK_CREATIONS_SHUTDOWN_AWAIT_SECONDS=30
AURALINK_CREATIONS_DEFAULT_PAGE_SIZE=20
AURALINK_CREATIONS_MAX_PAGE_SIZE=100

# Creation provider adapters (disabled until controlled ROUND 8.1 validation)
AURALINK_CREATION_PROVIDERS_ENABLED=false
AURALINK_PROVIDER_STAGING_DIR=/tmp/auralink-provider-staging
AURALINK_PROVIDER_MAX_IMAGE_INPUT_BYTES=10485760
AURALINK_PROVIDER_MAX_IMAGE_OUTPUT_BYTES=26214400
AURALINK_PROVIDER_MAX_AUDIO_OUTPUT_BYTES=268435456
AURALINK_PROVIDER_MAX_TEXT_CHARS=20000
AURALINK_PROVIDER_CONNECT_TIMEOUT_MS=5000
AURALINK_PROVIDER_QWEN_READ_TIMEOUT_MS=180000
AURALINK_PROVIDER_SEEDREAM_READ_TIMEOUT_MS=300000
AURALINK_PROVIDER_VMM_READ_TIMEOUT_MS=600000
AURALINK_PROVIDER_MAX_CONCURRENT_SEEDREAM=2
AURALINK_PROVIDER_MAX_CONCURRENT_QWEN=4
AURALINK_PROVIDER_MAX_CONCURRENT_VMM=1
AURALINK_SEEDREAM_DEFAULT_SIZE=2K
AURALINK_SEEDREAM_OUTPUT_FORMAT=png
AURALINK_SEEDREAM_WATERMARK=true

AURALINK_CORS_ALLOWED_ORIGINS=https://fanhualy.top,http://fanhualy.top,https://api.fanhualy.top,http://api.fanhualy.top,http://localhost:3000,https://localhost:3000,https://*.fanhualy.top,http://*.fanhualy.top
AURALINK_CORS_ALLOW_CREDENTIALS=true

AURALINK_HTTP_CONNECT_TIMEOUT_MS=15000
AURALINK_HTTP_READ_TIMEOUT_MS=120000
AURALINK_REMOTE_FETCH_MAX_BYTES=26214400
AURALINK_REMOTE_FETCH_CONNECT_TIMEOUT_MS=5000
AURALINK_REMOTE_FETCH_READ_TIMEOUT_MS=30000
AURALINK_REMOTE_FETCH_TOTAL_TIMEOUT_MS=120000
AURALINK_REMOTE_FETCH_MAX_REDIRECTS=3

